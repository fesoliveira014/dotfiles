[user]
	name = Felipe Oliveira
	email = fesoliveira@outlook.com
[credential]
	helper = store
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
