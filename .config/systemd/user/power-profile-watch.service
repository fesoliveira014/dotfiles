[Unit]
Description=Match the power profile to AC/battery state
Documentation=man:powerprofilesctl(1)
# Only meaningful inside a graphical session, since it sends notifications
# through the session's notification daemon.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/power-profile-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
