// niri config -- migrated from Regolith/i3
// KDL format. "/-" comments out the following node.

input {
    keyboard {
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
        scroll-method "two-finger"
    }
    // Keyboard-first, like i3
    /-focus-follows-mouse
}

output "eDP-1" {
    mode "2880x1800@120.000"
    // 1.8 -> 1600x1000 logical, both whole numbers.
    // 1.75 is rejected: 2880/1.75 = 1645.71 is not a whole pixel count.
    // Next roomier clean stop is 1.6 -> 1800x1125.
    scale 1.8
    variable-refresh-rate
    // Explicit positions, because the left edge of the leftmost output is now
    // load-bearing: lan-mouse puts its capture barrier there and crossing it
    // hands input to the Windows machine at 192.168.4.91. Leaving niri to
    // auto-arrange put DP-1 at x=0, which would have aimed that barrier at the
    // external monitor instead.
    position x=0 y=0

    // Centring is inverted relative to the global default below: it is useful
    // here and harmful on a big external. At 1600 logical two half-width
    // columns fit exactly, so on-overflow only kicks in once there are more
    // columns than fit -- which is exactly when centring the focused one helps.
    layout {
        center-focused-column "on-overflow"
    }
}

// No block for the external monitor, deliberately. It was scoped to "DP-1"
// and silently stopped applying when the same screen came back as "HDMI-A-1"
// -- the centring bug reappeared with the config untouched. Externals move
// between connectors; eDP-1 never does. So the external behaviour is now the
// global default and the laptop is the exception, which is connector-proof.
//
// Why centring is wrong on the external: column widths are fractions, so
// "proportion 0.5" is 800px on the laptop but 1526px on a 3072-wide output.
// Two of those plus gaps come to 3070.8 of 3072 -- about one pixel of slack.
// A third can never fit even partially, so "on-overflow" re-centres on every
// focus change past two windows, leaving one column flanked by two
// half-visible neighbours instead of a clean split.
//
// Position is left to niri too: it places a new output to the right of the
// existing ones, and eDP-1 is pinned at x=0, so the laptop stays leftmost
// whatever the external is called. That matters -- lan-mouse's capture
// barrier lives on the leftmost output's left edge.

layout {
    gaps 6
    // "never" as the default; eDP-1 overrides it to "on-overflow" above.
    center-focused-column "never"

    // Mod+R cycles these. The essential control on a 14-inch screen.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#E6B450"    // ayu-dark gold, carried from Regolith
        inactive-color "#232834"
    }
    border {
        off
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-c" "#0D1017"

// Clipboard history. wl-paste watches the selection and hands each entry to
// cliphist's database; Mod+C reads it back through fuzzel. Text and images are
// separate watchers because wl-paste subscribes to one MIME class at a time.
spawn-sh-at-startup "wl-paste --type text --watch /home/fesoliveira/go/bin/cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch /home/fesoliveira/go/bin/cliphist store"

// Night colour temperature, for Edmonton (53.5N, -113.5W). wlsunset computes
// sunrise and sunset from the coordinates rather than fixed clock times, which
// matters this far north where they move by hours across the year.
spawn-at-startup "/home/fesoliveira/.local/bin/wlsunset" "-l" "53.5" "-L" "-113.5" "-t" "3500" "-T" "6500"
// hyprlock rather than swaylock: it queries fprintd over D-Bus directly, so it
// can prompt for a finger and listen from the moment the screen locks.
// swaylock could only reach the reader through PAM, which meant no prompt and
// no scan until you pressed Enter. Config in ~/.config/hypr/hyprlock.conf.
spawn-at-startup "swayidle" "-w" \
    "timeout" "600" "/home/fesoliveira/.local/bin/hyprlock" \
    "before-sleep" "/home/fesoliveira/.local/bin/hyprlock"

// Float things that are really dialogs -- the command-line complaint,
// answered declaratively. Mod+V floats anything else on demand.
window-rule {
    match app-id=r#"^(pavucontrol|nm-connection-editor|blueman-manager)$"#
    match app-id=r#"^org\.gnome\.(Nautilus|Calculator)$"#
    open-floating true
    default-column-width { proportion 0.45; }
}

// c3vox: float it and leave the size alone. Deliberately no
// default-column-width/default-window-height -- niri's new_window_size()
// resolves an unspecified dimension to 0, and a 0 in the configure hands the
// choice back to the client, which is what makes SDL's 1280x720 stick.
//
// Matched on a prefix, because the app-id is whatever SDL_GetAppID last
// resolved to and that has already moved once. The vendored libSDL3.a has no
// wayland backend, so this runs through xwayland-satellite, which forwards
// WM_CLASS res_class -- SDL fills res_name with the /proc/self/exe basename
// ("vox-linux-debug") and res_class with SDL_GetAppID, i.e. the appidentifier
// passed to set_app_metadata in src/platform/platform.c3 ("vox.c3l").
// A prefix covers both spellings and survives the next rename.
window-rule {
    match app-id=r#"^vox"#
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "/home/fesoliveira/.local/bin/alacritty"; }
    Mod+D      hotkey-overlay-title="Launcher" { spawn "fuzzel"; }
    Mod+C      hotkey-overlay-title="Clipboard history" { spawn-sh "/home/fesoliveira/go/bin/cliphist list | fuzzel --dmenu | /home/fesoliveira/go/bin/cliphist decode | wl-copy"; }
    Mod+Q      repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Mod+Escape { spawn "/home/fesoliveira/.local/bin/hyprlock"; }

    // hjkl, exactly as in i3
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // Send the focused window to another monitor. Chord is niri's upstream
    // default; the action is not -- upstream binds move-column-to-monitor-*
    // here and lists move-window-to-monitor-* as the commented alternative
    // right below it. The window variant is the one that matches the rest of
    // the Mod+Shift+<num> binds above: peel off one window, leave the column.
    //
    // Up/down do nothing while both outputs sit side by side, but they cost
    // nothing and start working the moment the arrangement is stacked.
    Mod+Shift+Ctrl+H { move-window-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-window-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-window-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-window-to-monitor-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Throw the focused *window* to a workspace. These differ from the
    // Mod+Ctrl binds above in more than the chord: move-window-to-workspace
    // takes a single window out of its column, where move-column-to-workspace
    // takes the whole column with it. On a stacked column that is the
    // difference between peeling one window off and moving all of them.
    //
    // 0 maps to workspace 10 -- niri indices are 1-based and the number row
    // reads 1..9 then 0, the same mapping i3 used.
    //
    // Focus follows the window (niri's default). Append `focus=false` to any
    // of these to stay put instead, which is what i3's `move container` did.
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // The three that matter on a small screen
    Mod+R       { switch-preset-column-width; }
    Mod+W       { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Ctrl+F  { expand-column-to-available-width; }

    // Dual-purpose: on a floating window this centers it in the working
    // area (below waybar, not behind it); on a tiled one it centers the
    // column in the viewport. Needed mainly because Mod+V on a tiled
    // window drops it near where it already was rather than centered --
    // only genuinely-new floating windows open centered.
    Mod+Shift+C { center-window; }

    // Fine-grained resize, 10% per press. Upstream's chords, not the
    // Mod+Ctrl+Shift+hjkl set that would read naturally next to the
    // movement binds -- that combination is already spoken for by
    // move-window-to-monitor-* above.
    //
    // set-window-width rather than set-column-width so these stay
    // dual-purpose like Mod+Shift+C: on a floating window they resize the
    // window, on a tiled one they fall through to the column's width.
    Mod+Minus       { set-window-width "-10%"; }
    Mod+Equal       { set-window-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Touchpad and mouse scrolling through columns
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // These route through ~/.local/bin/osd, which performs the change and then
    // draws the level through mako. swayosd is the usual answer but is neither
    // packaged for noble nor worth a GTK source build for a progress bar.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "volume" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "volume" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "mic" "mute"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/fesoliveira/.local/bin/osd" "brightness" "down"; }

    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
}
